<!-- Plugin configuration file. See https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
  <id>ai.blamely</id>
  <name>Blamely</name>
  <version>1.1.0</version>
  <vendor email="support@blamely.ai" url="https://blamely.ai">Blamely</vendor>

  <description><![CDATA[
    <p>Display AI vs human code attribution from <b>oobeya-cli</b> (blamely) runtime data and git note reports.</p>
    <p>Requires <code>blamely install</code> and <code>blamely daemon</code>. Reports are written by oobeya-cli on commit to <code>refs/notes/blamely</code>.</p>
  ]]></description>

  <change-notes><![CDATA[
    <h3>1.1.0</h3>
    <ul>
      <li>Read-only consumer of oobeya-cli SQLite runtime data and JSON git notes.</li>
      <li>Removed IDE-side edit detection, hooks, and report generation.</li>
    </ul>
  ]]></change-notes>

  <depends>com.intellij.modules.platform</depends>
  <depends>Git4Idea</depends>

  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceImplementation="ai.blamely.settings.BlamelySettings"/>
    <applicationConfigurable parentId="tools" instance="ai.blamely.settings.BlamelyConfigurable"
      id="ai.blamely.settings.BlamelyConfigurable" displayName="Blamely" icon="/META-INF/pluginIcon.svg"
      groupWeight="-100"/>
    <notificationGroup id="Blamely" displayType="BALLOON"/>
    <projectService serviceImplementation="ai.blamely.core.BlameMapService"/>
    <projectService serviceImplementation="ai.blamely.cli.CliDataService"/>
    <projectService serviceImplementation="ai.blamely.ui.BlameDecorations"/>
    <projectService serviceImplementation="ai.blamely.completion.CompletionDetector"/>
    <postStartupActivity implementation="ai.blamely.BlamelyStartupActivity"/>
    <toolWindow id="Blamely" factoryClass="ai.blamely.ui.BlamelyToolWindowFactory"
          secondary="false" anchor="bottom" icon="/icons/toolwindow-ai.svg"/>
    <statusBarWidgetFactory implementation="ai.blamely.ui.BlamelyStatusBarWidgetFactory" id="Blamely.BlameStatus"/>
  </extensions>

  <actions>
    <group id="Blamely.MainMenu" text="Blamely" description="AI / Human" icon="/META-INF/pluginIcon.svg">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
      <action id="Blamely.ShowBlame" class="ai.blamely.actions.ShowBlameAction"
          text="Show Blame for Current File" description="Refresh gutter attribution for active editor"/>
    </group>
  </actions>
</idea-plugin>
